// OMO configuration
{
	"$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
	"[opencode]": {
		"agents": {
			"sisyphus": {
				"model": "anthropic/claude-opus-4-8",
				"prompt_append": "file://~/.omo/prompts/sisyphus.md",
				"fallback_models": [{ "model": "openai/gpt-5.6-sol", "reasoningEffort": "high" }],
				"ultrawork": {
					"model": "anthropic/claude-opus-4-8",
					"reasoning": "xhigh"
				}
			},
			"hephaestus": {
				"model": "xai/grok-4.6",
				"prompt_append": "file://~/.omo/prompts/hephaestus.md",
				"permission": {
					"edit": "allow",
					"bash": {
						"git": "allow",
						"test": "allow"
					}
				},
				"reasoning": "medium"
			},
			"prometheus": {
				"model": "anthropic/claude-opus-4-8",
				"prompt_append": "Keep plans concise. Focus on file structure and key decisions.",
				"reasoning": "high",
				"fallback_models": [{ "model": "openai/gpt-5.6-sol", "reasoningEffort": "high" }]
			},
			"oracle": {
				"model": "anthropic/claude-opus-4-8",
				"reasoning": "high",
				"fallback_models": [{ "model": "openai/gpt-5.6-sol", "reasoningEffort": "high" }]
			},
			"librarian": {
				"model": "openai/gpt-5.4-fast",
				"reasoning": "low"
			},
			"explore": {
				"model": "openai/gpt-5.4-fast",
				"reasoning": "low"
			},
			"multimodal-looker": {
				"model": "openai/gpt-5.5",
				"reasoning": "medium"
			},
			"metis": {
				"model": "xai/grok-4.6",
				"prompt_append": "Critically evaluate plans. Identify gaps, risks, and improvements. Be thorough.",
				"reasoning": "xhigh"
			},
			"momus": {
				"model": "openai/gpt-5.6-sol",
				"prompt_append": "Focus on code quality, edge cases, and test coverage.",
				"reasoning": "high"
			},
			"atlas": {
				"model": "xai/grok-4.6",
				"reasoning": "medium"
			},
			"sisyphus-junior": {
				"model": "anthropic/claude-opus-4-8",
				"reasoning": "medium"
			},
			"git": {
				"model": "openai/gpt-5.5-fast"
			},
			"argus": {
				"model": "openai/gpt-5.6-sol",
				"reasoning": "high"
			},
			"clio": {
				"model": "xai/grok-4.6",
				"reasoning": "high"
			},
			"viridian": {
				"model": "opencode/gemini-3.1-pro"
			}
		},
		"categories": {
			"quick": {
				"model": "anthropic/claude-haiku-4-5",
				"reasoning": "low"
			},
			"unspecified-low": {
				"model": "anthropic/claude-sonnet-4-6",
				"reasoning": "medium"
			},
			"unspecified-high": {
				"model": "xai/grok-4.6",
				"reasoning": "high"
			},
			"visual-engineering": {
				"model": "xai/grok-4.6",
				"reasoning": "high"
			},
			"deep": {
				"model": "xai/grok-4.6",
				"reasoning": "medium"
			},
			"ultrabrain": {
				"model": "xai/grok-4.6",
				"reasoning": "xhigh"
			},
			"writing": {
				"model": "anthropic/claude-opus-4-8"
			}
		},
		"background_task": {
			"defaultConcurrency": 30,
			"providerConcurrency": {
				"anthropic": 10,
				"openai": 16,
				"opencode": 16,
				"xai": 16
			}
		},
		"git_master": {
			"commit_footer": false,
			"include_co_authored_by": false,
			"git_env_prefix": "GIT_MASTER=1"
		},
		"hashline_edit": true,
		"experimental": {
			"aggressive_truncation": true,
			"task_system": true
		},
		"claude_code": {
			"mcp": false,
			"commands": false,
			"skills": false,
			"agents": false,
			"hooks": false,
			"plugins": false
		}
	},
	"_migrations": ["2026-07-opencode-config-unification", "2026-08-reasoning-unification"]
}
