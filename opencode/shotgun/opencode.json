{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": true,
	"model": "openai/gpt-5.6-sol",
	"enabled_providers": ["openai", "xai", "opencode", "anthropic", "claude-max"],
	"plugin": ["./plugin/meridian.ts", "opencode-with-claude", "oh-my-openagent@latest", "./plugin/block-oh-my-claude.ts"],
	"tools": {
		"*oh-my-claude*": false,
		"*oh_my_claude*": false,
		"*ohmyclaude*": false,
		"*oh my claude*": false,
		"*oh.my.claude*": false
	},
	"permission": {
		"*oh-my-claude*": "deny",
		"*oh_my_claude*": "deny",
		"*ohmyclaude*": "deny",
		"*oh my claude*": "deny",
		"*oh.my.claude*": "deny"
	},
	"lsp": {
		"marksman": {
			"command": ["marksman", "server"],
			"extensions": [".md"]
		}
	},
	"provider": {
		"anthropic": {
			"options": {
				"baseURL": "http://127.0.0.1:3456",
				"apiKey": "dummy"
			},
			"models": {
				"claude-opus-4-8": {},
				"claude-sonnet-4-6": {},
				"claude-haiku-4-5": {}
			}
		}
	},
	"mcp": {
		"figma": {
			"type": "remote",
			"url": "https://mcp.figma.com/mcp",
			"enabled": true,
			"oauth": {}
		},
		"shortcut": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.shortcut.com/mcp"
		},
		"postmark-template-sync": {
			"enabled": true,
			"type": "local",
			"command": ["node", "/Users/rbrown/workspace/photivo-support/postmark-template-sync-mcp/index.js"],
			"environment": {
				"POSTMARK_SERVER_TOKEN": "{env:POSTMARK_SERVER_TOKEN}"
			}
		},
		"drawio-generator": {
			"enabled": true,
			"type": "local",
			"command": ["uvx", "--python", "3.12", "drawio-mcp"],
			"environment": {}
		},
		"honeybadger": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.honeybadger.io/mcp",
			"oauth": {}
		}
	}
}
