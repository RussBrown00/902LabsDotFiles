#!/usr/bin/env bash
#
# wt — git worktree switcher for the current repo/product.
#
# A process can't cd its parent shell, so this script only PRINTS paths on
# stdout; callers cd into them, e.g. `cd "$(wt --name X)"`. UI, progress, and
# errors go to stderr. Run `wt --help` for details.
#
# Modes:
#   wt                 fzf picker over this repo's worktrees → print chosen path
#   wt --list          print "branch  path" table
#   wt --name <name>   print the worktree for <name>, creating it if missing
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/worktree.sh"

# usage — one-line synopsis. Goes to the given fd (stderr on error, stdout for --help).
usage() {
  cat <<'EOF'
Usage: wt [--list | --name <name> | --help]
EOF
}

# help_text — full --help output.
help_text() {
  cat <<'EOF'
wt — git worktree switcher for the current repo/product.

USAGE:
  wt                   Pick a worktree interactively with fzf; print its path.
  wt --list, -l        Print a "branch  path" table of this repo's worktrees.
  wt --name, -n NAME   Print the path of the worktree matching NAME. If none
                       exists, create branch NAME from origin/main and a worktree
                       for it under <repo>/.worktrees/NAME, copying .env files
                       across, then print the new path.
  wt --help, -h        Show this help.

OUTPUT:
  The picker and --name print a single worktree path to stdout; --list prints a
  table to stdout. All UI, progress, and errors go to stderr. A process cannot
  cd its parent shell, so to actually switch, cd into the printed path, e.g.:
      cd "$(wt --name ATOM-1234)"
  or wrap wt in a shell function that cd's into its stdout.

REPO RESOLUTION:
  The repo root is resolved from the shared git dir (git rev-parse
  --git-common-dir), so wt works from the main checkout and from inside any
  linked worktree — it always sees the full worktree set.

EXAMPLES:
  cd "$(wt)"                  # fuzzy-pick, then switch
  wt --list                  # list all worktrees
  cd "$(wt --name ATOM-1234)" # switch, creating from origin/main if missing
EOF
}

# Resolve REPO_ROOT to the main checkout so wt works from inside a worktree too.
# --git-common-dir points at the shared .git dir; its parent is the main root.
resolve_repo_root() {
  local common_dir
  common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || {
    echo "wt: not inside a git repository" >&2
    return 1
  }
  # Absolutize (git may print a relative path from cwd).
  common_dir="$(cd "$common_dir" && pwd)"
  printf '%s\n' "$(dirname "$common_dir")"
}

# list_worktrees — print "branch<TAB>path" for every worktree of REPO_ROOT.
list_worktrees() {
  local path="" branch=""
  while IFS= read -r line; do
    case "$line" in
    "worktree "*)
      path="${line#worktree }"
      branch="(detached)"
      ;;
    "branch "*)
      branch="${line#branch refs/heads/}"
      ;;
    "")
      [[ -n "$path" ]] && printf '%s\t%s\n' "$branch" "$path"
      path="" branch=""
      ;;
    esac
  done < <(
    git -C "$REPO_ROOT" worktree list --porcelain
    printf '\n'
  )
}

main() {
  REPO_ROOT="$(resolve_repo_root)" || return 1

  case "${1:-}" in
  --list | -l)
    list_worktrees | column -t -s $'\t'
    ;;
  --name | -n)
    local name="${2:-}"
    [[ -n "$name" ]] || {
      echo "wt: --name requires a worktree name" >&2
      usage >&2
      return 1
    }
    # Return the existing worktree when name uniquely matches; else create it.
    local dir
    if dir="$(resolve_worktree "$name" 2>/dev/null)"; then
      printf '%s\n' "$dir"
    else
      dir="$(create_worktree "$name")" || return 1
      printf '%s\n' "$dir"
    fi
    ;;
  -h | --help)
    help_text
    ;;
  "")
    # Interactive picker (fzf via lib), print the chosen path for the shell to cd.
    pick_worktree
    ;;
  *)
    echo "wt: unknown argument: $1" >&2
    usage >&2
    return 1
    ;;
  esac
}

main "$@"
